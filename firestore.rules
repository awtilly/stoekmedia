rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(realtorId) {
      return request.auth.uid == realtorId;
    }

    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function incomingRealtorIdMatchesAuth() {
      return request.resource.data.realtorId == request.auth.uid;
    }

    function realtorIdUnchanged() {
      return request.resource.data.realtorId == resource.data.realtorId;
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());

      // Users can only update their own doc, and only safe fields
      allow update: if isAuthenticated() && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'fullName', 'phone', 'company', 'emailSignature',
                         'showTour', 'onboardingComplete', 'onboardingCompletedAt',
                         'termsAcceptedAt', 'lastLogin'
                       ]);

      // Admins can do anything
      allow create, delete: if isAuthenticated() && isAdmin();
      allow update: if isAuthenticated() && isAdmin();
    }

    match /clients/{clientId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
      allow create: if isAuthenticated() && incomingRealtorIdMatchesAuth();
      allow update: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin()) && realtorIdUnchanged();
      allow delete: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
    }

    match /activities/{activityId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
      allow create: if isAuthenticated() && incomingRealtorIdMatchesAuth();
      allow update: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin()) && realtorIdUnchanged();
      allow delete: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
    }

    match /files/{fileId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
      allow create: if isAuthenticated() && incomingRealtorIdMatchesAuth();
      allow update: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin()) && realtorIdUnchanged();
      allow delete: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
    }

    match /templateFiles/{templateId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
      allow create: if isAuthenticated() && incomingRealtorIdMatchesAuth();
      allow update: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin()) && realtorIdUnchanged();
      allow delete: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
    }

    match /bookmarkedProperties/{propertyId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
      allow create: if isAuthenticated() && incomingRealtorIdMatchesAuth();
      allow update: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin()) && realtorIdUnchanged();
      allow delete: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
    }

    match /envelopes/{envelopeId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
      allow create: if isAuthenticated() && incomingRealtorIdMatchesAuth();
      allow update: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin()) && realtorIdUnchanged();
      allow delete: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
    }

    match /showings/{showingId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
      allow create: if isAuthenticated() && incomingRealtorIdMatchesAuth();
      allow update: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin()) && realtorIdUnchanged();
      allow delete: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
    }

    match /followUps/{followUpId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
      allow create: if isAuthenticated() && incomingRealtorIdMatchesAuth();
      allow update: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin()) && realtorIdUnchanged();
      allow delete: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
    }

    match /events/{eventId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
      allow create: if isAuthenticated() && incomingRealtorIdMatchesAuth();
      allow update: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin()) && realtorIdUnchanged();
      allow delete: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
    }

    match /listings/{listingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.addedBy == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && ((resource.data.addedBy == request.auth.uid && resource.data.source != "mls_sync") || isAdmin());
    }

    match /clientListingMatches/{matchId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
      allow create: if isAuthenticated() && incomingRealtorIdMatchesAuth();
      allow update: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin()) && realtorIdUnchanged();
      allow delete: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
    }

    match /searchHistory/{searchId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
      allow create: if isAuthenticated() && incomingRealtorIdMatchesAuth();
    }

    match /listingAlerts/{alertId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
      allow create: if isAuthenticated() && incomingRealtorIdMatchesAuth();
      allow update: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin()) && realtorIdUnchanged();
      allow delete: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
    }

    match /emailTemplates/{templateId} {
      allow read: if isAuthenticated() && (resource.data.createdBy == "system" || resource.data.createdBy == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    match /rateLimits/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /adminAuditLog/{logId} {
      allow read: if isAuthenticated() && isAdmin();
      allow create: if isAuthenticated() && isAdmin();
      // No update or delete — immutable audit trail
    }

    match /platformSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    match /trialRequests/{requestId} {
      // Anyone can submit a trial request (landing page form)
      allow create: if request.resource.data.keys().hasAll(['firstName', 'lastName', 'email', 'createdAt', 'status'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 0
                    && request.resource.data.email.size() < 255;
      // Only admins can read/manage requests
      allow read, update, delete: if isAuthenticated() && isAdmin();
    }
  }
}
