rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(realtorId) {
      return request.auth.uid == realtorId;
    }

    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function incomingRealtorIdMatchesAuth() {
      return request.resource.data.realtorId == request.auth.uid;
    }

    function realtorIdUnchanged() {
      return request.resource.data.realtorId == resource.data.realtorId;
    }

    function addedByUnchanged() {
      return request.resource.data.addedBy == resource.data.addedBy;
    }

    function sourceUnchanged() {
      return resource.data.source == null
          || request.resource.data.source == resource.data.source;
    }

    // True when `field` isn't part of this write's changes.
    function untouched(field) {
      return !(field in request.resource.data.diff(resource.data).affectedKeys());
    }

    // Server-maintained fields: a client may only clear them (null), never set them.
    function clearedOrUntouched(field) {
      return untouched(field) || request.resource.data.get(field, null) == null;
    }

    // Activity types the app writes. `type` is rendered in the admin panel,
    // so free-form strings (markup) are rejected outright.
    function validActivityType() {
      return request.resource.data.type in
        ['note', 'call', 'email', 'sms', 'showing', 'file_share', 'meeting', 'other'];
    }


    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());

      // Users can only update their own doc, and only safe fields.
      // The showingTime sync fields are written by Cloud Functions (they drive
      // the 15-minute sync throttle); the client may only clear them on
      // disconnect. termsAcceptedAt must be the server time (no backdating).
      allow update: if isAuthenticated() && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'fullName', 'phone', 'company', 'emailSignature',
                         'showTour', 'onboardingComplete', 'onboardingCompletedAt',
                         'termsAcceptedAt', 'lastLogin', 'fcmTokens',
                         'showingTimeFeedUrl', 'showingTimeLastSyncedAt', 'showingTimeSyncCount',
                         'showingTimeSyncError', 'timezone'
                       ])
                    && clearedOrUntouched('showingTimeLastSyncedAt')
                    && clearedOrUntouched('showingTimeSyncCount')
                    && clearedOrUntouched('showingTimeSyncError')
                    && (untouched('termsAcceptedAt') || request.resource.data.termsAcceptedAt == request.time)
                    && (untouched('fullName') || (request.resource.data.fullName is string
                                                  && request.resource.data.fullName.size() < 100));

      // Admins can do anything
      allow create, delete: if isAuthenticated() && isAdmin();
      allow update: if isAuthenticated() && isAdmin();

      // Studio: the realtor's saved marketing designs and brand kit (logo URL,
      // brokerage line). Owner only; photos live in Storage under users/{uid}/studio.
      match /studio/{docId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      // Push/in-app notifications: written by Cloud Functions only (admin SDK
      // bypasses rules); the owner may read, mark read, and dismiss.
      match /notifications/{notificationId} {
        allow read, delete: if isAuthenticated() && request.auth.uid == userId;
        allow update: if isAuthenticated() && request.auth.uid == userId
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create: if false;
      }
    }

    match /clients/{clientId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
      allow create: if isAuthenticated()
        && incomingRealtorIdMatchesAuth()
        && request.resource.data.keys().hasAll(['fullName', 'realtorId'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() < 200;
      allow update: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin()) && realtorIdUnchanged()
        && (untouched('fullName') || (request.resource.data.fullName is string
                                      && request.resource.data.fullName.size() < 200));
      allow delete: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());

      // Closing Checklist subcollection
      match /closingChecklist/{itemId} {
        allow read, write: if isAuthenticated()
          && get(/databases/$(database)/documents/clients/$(clientId)).data.realtorId == request.auth.uid;
      }

      // Compliance Docs subcollection
      match /complianceDocs/{docId} {
        allow read, write: if isAuthenticated()
          && get(/databases/$(database)/documents/clients/$(clientId)).data.realtorId == request.auth.uid;
      }
    }

    match /activities/{activityId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
      allow create: if isAuthenticated() && incomingRealtorIdMatchesAuth() && validActivityType();
      allow update: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin()) && realtorIdUnchanged()
        && (untouched('type') || validActivityType());
      allow delete: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
    }

    // storagePath feeds getFileSignedUrl and offboarding deletes, so a client
    // may only point it inside its own files/{uid}/ area, and never change it.
    // (Signed closing documents under clients/{id}/ are written by Functions.)
    match /files/{fileId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
      allow create: if isAuthenticated() && incomingRealtorIdMatchesAuth()
        && (request.resource.data.get('storagePath', null) == null
            || (request.resource.data.storagePath is string
                && request.resource.data.storagePath.matches('files/' + request.auth.uid + '/.+')))
        && (request.resource.data.get('downloadUrl', null) == null
            || (request.resource.data.downloadUrl is string
                && request.resource.data.downloadUrl.matches('https://.+')));
      allow update: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin()) && realtorIdUnchanged()
        && untouched('storagePath')
        && (untouched('downloadUrl')
            || (request.resource.data.downloadUrl is string
                && request.resource.data.downloadUrl.matches('https://.+')));
      allow delete: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
    }

    match /templateFiles/{templateId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
      allow create: if isAuthenticated() && incomingRealtorIdMatchesAuth();
      allow update: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin()) && realtorIdUnchanged();
      allow delete: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
    }

    match /bookmarkedProperties/{propertyId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
      allow create: if isAuthenticated() && incomingRealtorIdMatchesAuth();
      allow update: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin()) && realtorIdUnchanged();
      allow delete: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
    }

    match /envelopes/{envelopeId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
      allow create: if isAuthenticated() && incomingRealtorIdMatchesAuth();
      allow update: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin()) && realtorIdUnchanged();
      allow delete: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
    }

    match /showings/{showingId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
      allow create: if isAuthenticated() && incomingRealtorIdMatchesAuth();
      allow update: if isAuthenticated()
        && (isOwner(resource.data.realtorId) || isAdmin())
        && realtorIdUnchanged()
        && sourceUnchanged();
      allow delete: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
    }

    match /followUps/{followUpId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
      allow create: if isAuthenticated() && incomingRealtorIdMatchesAuth();
      allow update: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin()) && realtorIdUnchanged();
      allow delete: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
    }

    match /events/{eventId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
      allow create: if isAuthenticated() && incomingRealtorIdMatchesAuth();
      allow update: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin()) && realtorIdUnchanged();
      allow delete: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
    }

    match /folders/{folderId} {
      // Folders use deterministic ids and the client does getDoc-then-setDoc;
      // a get on a not-yet-existing doc must not throw on resource.data.
      allow get: if isAuthenticated() && (resource == null || isOwner(resource.data.realtorId) || isAdmin());
      allow list: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
      allow create: if isAuthenticated() && incomingRealtorIdMatchesAuth();
      allow update: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin()) && realtorIdUnchanged();
      allow delete: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
    }

    match /documentTemplates/{templateId} {
      // Read: any signed-in user can see seeded compliance templates AND their
      // own private templates. Brokerage-shared is reserved for a later phase.
      allow read: if isAuthenticated() && (
        resource.data.visibility == 'seeded'
        || resource.data.ownerId == request.auth.uid
        || isAdmin()
      );

      // Create: realtors may only create their own private templates.
      // Admins may create anything (seeded forms).
      allow create: if isAuthenticated() && (
        isAdmin()
        || (
          request.resource.data.ownerId == request.auth.uid
          && request.resource.data.visibility == 'private'
        )
      );

      // Update: owner can edit their own private template (ownership +
      // visibility must not change). Admin may edit anything.
      allow update: if isAuthenticated() && (
        isAdmin()
        || (
          resource.data.ownerId == request.auth.uid
          && resource.data.visibility == 'private'
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.visibility == resource.data.visibility
        )
      );

      // Delete: owner may delete their own private template, admin anything.
      // Seeded templates can only be removed by admin.
      allow delete: if isAuthenticated() && (
        isAdmin()
        || (resource.data.ownerId == request.auth.uid && resource.data.visibility == 'private')
      );
    }

    match /listings/{listingId} {
      allow read: if isAuthenticated()
        && (resource.data.addedBy == request.auth.uid || isAdmin());
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['address', 'addedBy', 'createdAt'])
        && request.resource.data.addedBy == request.auth.uid
        && (request.resource.data.listingUrl == null
            || request.resource.data.listingUrl == ""
            || request.resource.data.listingUrl.matches('^https?://.*'));
      allow update: if isAuthenticated()
        && (resource.data.addedBy == request.auth.uid || isAdmin())
        && addedByUnchanged()
        && sourceUnchanged()
        && (request.resource.data.listingUrl == null
            || request.resource.data.listingUrl == ""
            || request.resource.data.listingUrl.matches('^https?://.*'));
      allow delete: if isAuthenticated() && ((resource.data.addedBy == request.auth.uid && resource.data.source != "mls_sync") || isAdmin());
    }

    match /clientListingMatches/{matchId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
      allow create: if isAuthenticated() && incomingRealtorIdMatchesAuth();
      allow update: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin()) && realtorIdUnchanged();
      allow delete: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
    }

    match /searchHistory/{searchId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
      allow create: if isAuthenticated() && incomingRealtorIdMatchesAuth();
    }

    match /listingAlerts/{alertId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
      allow create: if isAuthenticated() && incomingRealtorIdMatchesAuth();
      allow update: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin()) && realtorIdUnchanged();
      allow delete: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
    }

    match /followUpSequences/{sequenceId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
      allow create: if isAuthenticated() && incomingRealtorIdMatchesAuth();
      allow update: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin()) && realtorIdUnchanged();
      allow delete: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
    }

    match /sequenceEnrollments/{enrollmentId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
      // Writes go through Cloud Functions (admin SDK bypasses rules); deny client writes.
      allow write: if false;
    }

    match /emailTemplates/{templateId} {
      allow read: if isAuthenticated() && (resource.data.createdBy == "system" || resource.data.createdBy == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      // createdBy is frozen: re-labelling a template "system" would push it
      // into every realtor's template picker.
      allow update: if isAuthenticated() && (resource.data.createdBy == request.auth.uid || isAdmin())
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAuthenticated() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // Daily LLM/email/SMS quotas. Written only by Cloud Functions (admin SDK);
    // a client-writable doc would let anyone reset their own limits.
    match /rateLimits/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if false;
    }

    match /adminAuditLog/{logId} {
      allow read: if isAuthenticated() && isAdmin();
      allow create: if isAuthenticated() && isAdmin();
      // No update or delete — immutable audit trail
    }

    match /platformSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    match /trialRequests/{requestId} {
      // Anyone can submit a trial request (landing page form)
      allow create: if request.resource.data.keys().hasAll(['firstName', 'lastName', 'email', 'createdAt', 'status'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 0
                    && request.resource.data.email.size() < 255;
      // Only admins can read/manage requests
      allow read, update, delete: if isAuthenticated() && isAdmin();
    }

    // OAuth refresh/access tokens — Cloud Functions only (admin SDK bypasses).
    // No client read or write under any circumstance.
    match /oauthTokens/{userId} {
      allow read, write: if false;
    }
  }
}
