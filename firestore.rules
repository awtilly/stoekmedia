rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(realtorId) {
      return request.auth.uid == realtorId;
    }

    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function incomingRealtorIdMatchesAuth() {
      return request.resource.data.realtorId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    match /clients/{clientId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
      allow create: if isAuthenticated() && incomingRealtorIdMatchesAuth();
      allow update, delete: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
    }

    match /activities/{activityId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
      allow create: if isAuthenticated() && incomingRealtorIdMatchesAuth();
      allow update, delete: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
    }

    match /files/{fileId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
      allow create: if isAuthenticated() && incomingRealtorIdMatchesAuth();
      allow update, delete: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
    }

    match /bookmarkedProperties/{propertyId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
      allow create: if isAuthenticated() && incomingRealtorIdMatchesAuth();
      allow update, delete: if isAuthenticated() && (isOwner(resource.data.realtorId) || isAdmin());
    }
  }
}
