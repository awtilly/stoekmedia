rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User files (contracts, disclosures, etc.)
    match /files/{realtorUid}/{allPaths=**} {
      allow read: if request.auth != null
        && request.auth.uid == realtorUid;
      allow write: if request.auth != null
        && request.auth.uid == realtorUid
        && request.resource.size < 25 * 1024 * 1024;
    }

    // Listing photos — any auth user can read, only auth users can write
    // 10 MB max, images only
    match /listings/{listingId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Document templates — owner only, 25 MB max
    match /templates/{realtorUid}/{allPaths=**} {
      allow read: if request.auth != null
        && request.auth.uid == realtorUid;
      allow write: if request.auth != null
        && request.auth.uid == realtorUid
        && request.resource.size < 25 * 1024 * 1024;
    }
  }
}
